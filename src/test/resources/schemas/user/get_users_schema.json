{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "username", "email"],
    "additionalProperties": true,
    "properties": {
      "id":       { "type": "integer", "minimum": 1 },
      "name":     { "type": "string",  "minLength": 1 },
      "username": { "type": "string",  "minLength": 1 },
      "email":    { "type": "string",  "format": "email" },
      "phone":    { "type": "string" },
      "website":  { "type": "string" },
      "address": {
        "type": "object",
        "required": ["street", "city", "zipcode"],
        "additionalProperties": true,
        "properties": {
          "street":  { "type": "string" },
          "suite":   { "type": "string" },
          "city":    { "type": "string" },
          "zipcode": { "type": "string" },
          "geo": {
            "type": "object",
            "required": ["lat", "lng"],
            "properties": {
              "lat": { "type": "string" },
              "lng": { "type": "string" }
            }
          }
        }
      },
      "company": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": true,
        "properties": {
          "name":        { "type": "string" },
          "catchPhrase": { "type": "string" },
          "bs":          { "type": "string" }
        }
      }
    }
  }
}